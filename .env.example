# PostgreSQL 연결 주소 (Neon 또는 Supabase에서 복사)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# 로그인 토큰 서명용 비밀 문자열 (32자 이상 아무 문자열)
AUTH_SECRET="여기에-길고-랜덤한-문자열을-넣으세요-32자-이상"

# Google AI Studio에서 발급받은 Gemini API 키
GEMINI_API_KEY=""

# (선택) 사용할 Gemini 모델. 비워두면 gemini-3.8-flash → gemini-3.5-flash-lite 순서로 시도
GEMINI_MODEL=""
